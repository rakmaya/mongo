load("//bazel:mongo_src_rules.bzl", "mongo_cc_library", "mongo_cc_unit_test")

package(default_visibility = ["//visibility:public"])

mongo_cc_library(
    name = "hcindex",
    srcs = [
        "bitmap_index.cpp",
        "collection_manager.cpp",
        "reader.cpp",
        "writer.cpp",
        "temporal_attribute_table.cpp",
        "temporal_symbol_dictionary.cpp",
    ],
    hdrs = [
        "bitmap_index.h",
        "collection_manager.h",
        "isymbol_dictionary.h",
        "reader.h",
        "writer.h",
        "temporal_attribute_table.h",
        "temporal_symbol_dictionary.h",
    ],
    private_hdrs = [
        "//src/mongo/db/timeseries:hcindex_options.h",
    ],
    deps = [
